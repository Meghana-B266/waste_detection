# Copy this file to ".env" and fill in your own values.
# Never commit the real ".env" file — it's already in .gitignore.

# ---------- Camera ----------
# IP shown by the "IP Webcam" app on your Android phone (Settings > find IP).
# If left blank, run_complete_system.py will ask for it interactively.
PHONE_IP=192.168.0.105

# ---------- Model & Detection ----------
MODEL_PATH=models/best.pt
CONFIDENCE_THRESHOLD=0.35
IOU_THRESHOLD=0.35
MIN_BOX_AREA=800

# Water-specific detection enhancements (used by run_complete_system.py)
USE_WATER_ENHANCEMENT=true
USE_MULTISCALE=true
USE_ADAPTIVE_THRESHOLD=true

# ---------- Database ----------
# Relative path is resolved from the project root at runtime.
DATABASE_URL=sqlite:///./data/waste_detection.db

# ---------- Location (used for alert emails / map links) ----------
USE_PHONE_GPS=false
CAMERA_LATITUDE=12.90111
CAMERA_LONGITUDE=77.51806
CAMERA_LOCATION=RNS Institute of Technology

# ---------- Alerts ----------
ALERT_THRESHOLD=5

# ---------- Email (Gmail example) ----------
# ENABLE_EMAIL must be "true" for any email to be sent.
# For Gmail: create an "App Password" (not your normal password) at
# https://myaccount.google.com/apppasswords and use that here.
ENABLE_EMAIL=false
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
EMAIL_FROM=your_email@gmail.com
EMAIL_PASSWORD=your_16_char_app_password
ALERT_EMAIL_TO=recipient@example.com
